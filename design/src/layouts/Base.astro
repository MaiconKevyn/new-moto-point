---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotaoZapFlutuante from '../components/BotaoZapFlutuante.astro';
import { site, contato, endereco, redes } from '../data/site';
import { url } from '../data/navegacao';

interface Props {
  titulo?: string;
  descricao?: string;
  /** Usado na 404: página útil para quem chega, inútil no índice do Google. */
  semIndexacao?: boolean;
  /** Nome da página no caminho de migalhas. Só as páginas internas passam. */
  migalha?: string;
}

const {
  titulo = `${site.nome} — Peças, Acessórios e Oficina de Motos em Porto Alegre`,
  descricao = site.descricao,
  semIndexacao = false,
  migalha,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Imagem de compartilhamento (WhatsApp, Facebook, Instagram) — precisa ser absoluta
const ogImagem = new URL(url('/og.jpg'), Astro.site).href;

// Dados estruturados para busca local (Google Business / rich results)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MotorcycleRepair',
  name: site.nome,
  description: site.descricao,
  slogan: site.slogan,
  foundingDate: String(site.desde),
  url: new URL(url('/'), Astro.site).href,
  telephone: '+55 51 3028-7969',
  email: contato.email,
  priceRange: 'R$',
  currenciesAccepted: 'BRL',
  address: {
    '@type': 'PostalAddress',
    streetAddress: endereco.rua,
    addressLocality: endereco.cidade,
    addressRegion: endereco.estado,
    postalCode: endereco.cep,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: endereco.lat,
    longitude: endereco.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '13:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '14:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '17:00',
    },
  ],
  sameAs: [redes.instagram, redes.facebook],
  areaServed: { '@type': 'City', name: 'Porto Alegre' },
  makesOffer: [
    'Peças para motos',
    'Acessórios para motos',
    'Roupas de moto',
    'Oficina mecânica de motos',
    'Tele entrega de peças',
  ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
};

// Caminho de migalhas para a busca — só existe nas páginas internas.
const migalhasLd = migalha
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(url('/'), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: migalha, item: canonical },
      ],
    }
  : null;
---

<!doctype html>
<html lang="pt-BR" class="scheme-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fdfbf6" />
    <meta name="generator" content={Astro.generator} />

    {semIndexacao && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="New Moto Point — peças, acessórios e oficina de motos na Av. Farrapos, Porto Alegre"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImagem} />

    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    {
      migalhasLd && (
        <script type="application/ld+json" set:html={JSON.stringify(migalhasLd)} is:inline />
      )
    }
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-ambar-400 focus:px-5 focus:py-3 focus:font-semibold focus:text-tinta-950"
    >
      Ir para o conteúdo
    </a>

    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <BotaoZapFlutuante />

    <script>
      // Revelação ao rolar — enfeite, não requisito. Só escondemos o conteúdo
      // depois de garantir que temos como revelá-lo de volta.
      const alvos = document.querySelectorAll<HTMLElement>('.reveal');
      const movimentoReduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (alvos.length && 'IntersectionObserver' in window && !movimentoReduzido) {
        document.documentElement.classList.add('js-reveal');

        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        alvos.forEach((el) => io.observe(el));

        // Rede de segurança: se por algum motivo o observer não entregar,
        // o conteúdo aparece em vez de ficar preso invisível.
        setTimeout(() => {
          alvos.forEach((el) => el.classList.add('is-visible'));
        }, 4000);
      }
    </script>
  </body>
</html>
