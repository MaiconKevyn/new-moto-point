---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { site, contato, zap } from '../data/site';
import { url } from '../data/navegacao';

const atalhos = [
  { href: '/loja/', rotulo: 'Catálogo da loja', icone: 'loja' },
  { href: '/loja/#ofertas', rotulo: 'Ofertas', icone: 'estrela' },
  { href: '/oficina/', rotulo: 'Serviços da oficina', icone: 'ferramentas' },
  { href: '/loja/#pecas', rotulo: 'Peças de reposição', icone: 'motor' },
  { href: '/loja/#chuva', rotulo: 'Acessórios', icone: 'bau' },
  { href: '/contato/', rotulo: 'Endereço e horários', icone: 'local' },
];
---

<Base
  titulo={`Página não encontrada — ${site.nome}`}
  descricao="A página que você procurou não existe mais. Veja as ofertas, os serviços da oficina ou fale com a New Moto Point no WhatsApp."
  semIndexacao
>
  <section class="relative overflow-hidden bg-graphite-950">
    <div class="grid-texture absolute inset-0 opacity-50"></div>
    <div class="absolute -top-32 -right-24 size-[32rem] rounded-full bg-moto-700/16 blur-[130px]">
    </div>

    <div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:py-32">
      <p class="display text-[26vw] leading-none text-white/8 sm:text-[12rem]">404</p>

      <h1 class="display -mt-6 text-4xl text-white sm:-mt-10 sm:text-6xl">
        Essa página <span class="text-moto-500 italic">saiu de linha.</span>
      </h1>

      <p class="mx-auto mt-5 max-w-lg text-[15px] leading-relaxed text-white/60 sm:text-base">
        O endereço que você abriu não existe mais. Mas a loja continua no mesmo lugar, na Av.
        Farrapos — escolha um atalho abaixo ou chama no WhatsApp que a gente resolve.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={url('/')}
          class="group flex items-center justify-center gap-2.5 rounded-xl bg-moto-500 px-7 py-4 font-bold text-white shadow-lg shadow-moto-700/30 transition-all hover:bg-moto-600"
        >
          <Icone nome="moto" class="size-5.5" />
          Voltar para a página inicial
        </a>
        <a
          href={zap('Olá! Caí numa página que não existe no site. Preciso de ajuda com: ')}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2.5 rounded-xl bg-zap-500 px-7 py-4 font-bold text-graphite-950 shadow-lg shadow-zap-500/20 transition-all hover:bg-zap-400"
        >
          <Icone nome="whatsapp" class="size-5.5" />
          Falar no WhatsApp
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap justify-center gap-2.5">
        {
          atalhos.map((a) => (
            <li>
              <a
                href={url(a.href)}
                class="flex items-center gap-2 rounded-lg border border-white/12 bg-white/4 px-4 py-2.5 text-sm font-semibold text-white/75 transition-all hover:border-moto-500/50 hover:bg-moto-500/10 hover:text-white"
              >
                <Icone nome={a.icone} class="size-4.5 text-moto-400" />
                {a.rotulo}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-sm text-white/40">
        Ou ligue para <a
          href={contato.telefoneFixoHref}
          class="font-semibold text-white underline decoration-moto-500 decoration-2 underline-offset-4 transition-colors hover:text-moto-400"
          >{contato.telefoneFixo}</a
        >.
      </p>
    </div>
  </section>
</Base>
