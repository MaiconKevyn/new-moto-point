---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { site, contato, zap } from '../data/site';
import { url } from '../data/navegacao';

const atalhos = [
  { href: '/loja/', rotulo: 'Catálogo da loja', icone: 'loja' },
  { href: '/loja/#ofertas', rotulo: 'Ofertas', icone: 'estrela' },
  { href: '/oficina/', rotulo: 'Serviços da oficina', icone: 'ferramentas' },
  { href: '/loja/#pecas', rotulo: 'Peças de reposição', icone: 'motor' },
  { href: '/loja/#chuva', rotulo: 'Acessórios', icone: 'bau' },
  { href: '/contato/', rotulo: 'Endereço e horários', icone: 'local' },
];
---

<Base
  titulo={`Página não encontrada — ${site.nome}`}
  descricao="A página que você procurou não existe mais. Veja as ofertas, os serviços da oficina ou fale com a New Moto Point no WhatsApp."
  semIndexacao
>
  <section class="bg-creme-50">
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:py-32">
      <p class="display text-[22vw] leading-none text-ambar-300 sm:text-[11rem]">404</p>

      <h1 class="display -mt-4 text-3xl text-tinta-950 sm:-mt-8 sm:text-5xl">
        Essa página <span class="text-ambar-500 italic">saiu de linha.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-lg text-[15px] leading-relaxed text-tinta-500 sm:text-base">
        O endereço que você abriu não existe mais. Mas a loja continua no mesmo lugar, na Av.
        Farrapos — escolha um atalho abaixo ou chama no WhatsApp que a gente resolve.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={url('/')}
          class="group flex items-center justify-center gap-2.5 rounded-full bg-tinta-950 px-7 py-4 font-semibold text-white transition-all hover:bg-ambar-400 hover:text-tinta-950"
        >
          <Icone nome="moto" class="size-5.5" />
          Voltar para a página inicial
        </a>
        <a
          href={zap('Olá! Caí numa página que não existe no site. Preciso de ajuda com: ')}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2.5 rounded-full border border-tinta-950/20 px-7 py-4 font-semibold text-tinta-950 transition-all hover:border-zap-500 hover:bg-zap-500"
        >
          <Icone nome="whatsapp" class="size-5.5" />
          Falar no WhatsApp
        </a>
      </div>

      <ul class="mx-auto mt-14 max-w-md border-t border-tinta-950/14 text-left">
        {
          atalhos.map((a) => (
            <li class="fio group">
              <a href={url(a.href)} class="flex items-center gap-4 py-4">
                <Icone nome={a.icone} class="size-5 shrink-0 text-ambar-500" />
                <span class="display flex-1 text-xl text-tinta-950 transition-colors group-hover:text-ambar-600">
                  {a.rotulo}
                </span>
                <Icone
                  nome="setaCurta"
                  class="size-4.5 text-tinta-400 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ambar-600"
                />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-sm text-tinta-500">
        Ou ligue para <a
          href={contato.telefoneFixoHref}
          class="font-semibold text-tinta-950 underline decoration-ambar-500 decoration-2 underline-offset-4 transition-colors hover:text-ambar-600"
          >{contato.telefoneFixo}</a
        >.
      </p>
    </div>
  </section>
</Base>
