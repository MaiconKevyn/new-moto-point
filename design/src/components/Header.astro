---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import logo from '../assets/img/brand/logo-new-moto.png';
import { site, contato, zap } from '../data/site';
import { navegacao, ehAtivo, url } from '../data/navegacao';

const caminho = Astro.url.pathname;
---

<header id="topo" class="sticky top-0 z-50 bg-carbon-950/92 backdrop-blur-lg">
  <!-- Faixa vermelha de utilidades -->
  <div class="grad-rubi hidden lg:block">
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-2 text-[12.5px] font-medium text-white/90"
    >
      <p class="flex items-center gap-2">
        <Icone nome="local" class="size-4" />
        Av. Farrapos, 1255 — esquina com a Rua Hoffmann, Floresta
      </p>
      <div class="flex items-center gap-7">
        <span class="flex items-center gap-2">
          <Icone nome="relogio" class="size-4" />
          Seg a sex 8h–18h · Sáb 9h–17h
        </span>
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2 font-bold transition-opacity hover:opacity-80"
        >
          <Icone nome="telefone" class="size-4" />
          {contato.telefoneFixo}
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl items-center gap-4 border-b border-white/8 px-4 py-3 sm:px-6">
    <a href={url('/')} class="group flex shrink-0 items-center gap-3" aria-label={`${site.nome} — início`}>
      <Image
        src={logo}
        alt=""
        width={112}
        height={83}
        loading="eager"
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <span class="hidden sm:block">
        <span class="display block text-lg leading-none text-white">
          New Moto <span class="text-rubi-500">Point</span>
        </span>
        <span class="rotulo mt-1 block text-[9px] text-white/40">Peças · Acessórios · Oficina</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center lg:flex" aria-label="Navegação principal">
      {
        navegacao.map((item) => {
          const ativo = ehAtivo(caminho, item.href);

          if (!item.sub) {
            return (
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'group relative px-4 py-2.5 text-[13px] font-bold tracking-wider uppercase transition-colors hover:text-white',
                  ativo ? 'text-rubi-400' : 'text-white/65',
                ]}
              >
                {item.rotulo}
                <span
                  class:list={[
                    'absolute inset-x-4 bottom-1 h-0.5 origin-left bg-rubi-500 transition-transform duration-300 group-hover:scale-x-100',
                    ativo ? 'scale-x-100' : 'scale-x-0',
                  ]}
                />
              </a>
            );
          }

          // Submenu: abre no hover e também ao receber foco pelo teclado.
          // Enquanto fechado usa `invisible`, então os links de dentro ficam
          // fora da ordem de tabulação até o item de cima ser focado.
          return (
            <div class="group relative">
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-1.5 px-4 py-2.5 text-[13px] font-bold tracking-wider uppercase transition-colors hover:text-white',
                  ativo ? 'text-rubi-400' : 'text-white/65',
                ]}
              >
                {item.rotulo}
                <Icone
                  nome="chevron"
                  class="size-4 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
                />
                <span
                  class:list={[
                    'absolute inset-x-4 bottom-1 h-0.5 origin-left bg-rubi-500 transition-transform duration-300 group-hover:scale-x-100',
                    ativo ? 'scale-x-100' : 'scale-x-0',
                  ]}
                />
              </a>

              <div class="invisible absolute top-full left-0 z-50 pt-2 opacity-0 transition-[opacity,transform] duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 max-lg:hidden lg:-translate-y-1">
                <ul class="w-60 border border-white/10 bg-carbon-900 py-1.5 shadow-2xl shadow-black/70">
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        class="flex items-center gap-3 border-l-2 border-transparent px-4 py-2.5 text-[13px] font-bold tracking-wide text-white/65 uppercase transition-all hover:border-rubi-500 hover:bg-rubi-500/12 hover:text-white"
                      >
                        {s.rotulo}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>

    <a
      href={zap('Olá! Quero um orçamento na New Moto Point. Minha moto é uma ')}
      target="_blank"
      rel="noopener"
      class="grad-rubi ml-auto flex items-center gap-2 rounded-sm px-5 py-3 text-[13px] font-extrabold tracking-wider text-white uppercase shadow-lg shadow-rubi-900/40 transition-all hover:brightness-115 lg:ml-6"
    >
      <Icone nome="whatsapp" class="size-5" />
      <span class="hidden sm:inline">Pedir orçamento</span>
      <span class="sm:hidden">Orçamento</span>
    </a>

    <button
      type="button"
      id="btn-menu"
      class="flex size-11 shrink-0 items-center justify-center rounded-sm border border-white/15 text-white transition-colors hover:border-rubi-500 hover:bg-rubi-500 lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path id="icone-abrir" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        <path id="icone-fechar" class="hidden" d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Menu mobile -->
  <div id="menu-mobile" hidden class="border-b border-white/10 bg-carbon-900 lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6" aria-label="Navegação principal (mobile)">
      <ul class="divide-y divide-white/8">
        {
          navegacao.map((item, i) => (
            <li class="py-1">
              <a
                href={url(item.href)}
                data-fechar-menu
                aria-current={ehAtivo(caminho, item.href) ? 'page' : undefined}
                class="flex items-center gap-4 py-3 transition-colors hover:text-rubi-400"
              >
                <span class="rotulo w-7 text-[11px] text-rubi-500">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span
                  class:list={[
                    'display flex-1 text-xl',
                    ehAtivo(caminho, item.href) ? 'text-rubi-400' : 'text-white/90',
                  ]}
                >
                  {item.rotulo}
                </span>
                <Icone nome="seta" class="size-5 text-rubi-500" />
              </a>

              {item.sub && (
                <ul class="mb-2 ml-11 flex flex-wrap gap-1.5">
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        data-fechar-menu
                        class="block border border-white/12 px-3 py-1.5 text-[12px] font-bold tracking-wide text-white/55 uppercase transition-colors hover:border-rubi-500 hover:text-white"
                      >
                        {s.rotulo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-4 grid gap-2 text-sm">
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2.5 rounded-sm bg-white/6 px-4 py-3 font-bold text-white"
        >
          <Icone nome="telefone" class="size-4.5 text-rubi-500" />
          {contato.telefoneFixo}
        </a>
        <p class="flex items-center gap-2.5 px-4 text-white/55">
          <Icone nome="relogio" class="size-4.5 text-rubi-500" />
          Seg a sex 8h–18h (fecha 13h–14h) · Sáb 9h–17h
        </p>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-mobile');
  const iAbrir = document.getElementById('icone-abrir');
  const iFechar = document.getElementById('icone-fechar');

  function alternar(aberto: boolean) {
    if (!btn || !menu) return;
    menu.hidden = !aberto;
    btn.setAttribute('aria-expanded', String(aberto));
    btn.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    iAbrir?.classList.toggle('hidden', aberto);
    iFechar?.classList.toggle('hidden', !aberto);
  }

  btn?.addEventListener('click', () => alternar(menu?.hidden !== false));
  menu
    ?.querySelectorAll('[data-fechar-menu]')
    .forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.hidden === false) alternar(false);
  });
</script>
