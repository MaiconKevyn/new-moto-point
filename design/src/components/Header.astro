---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import logo from '../assets/img/brand/logo-new-moto.png';
import { site, contato, zap } from '../data/site';
import { navegacao, ehAtivo, url } from '../data/navegacao';

const caminho = Astro.url.pathname;
---

<header id="topo" class="sticky top-0 z-50 bg-creme-50/92 backdrop-blur-lg">
  <!-- Fio de utilidades -->
  <div class="hidden border-b border-tinta-950/8 bg-creme-100 lg:block">
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-2 text-[12.5px] text-tinta-500"
    >
      <p class="flex items-center gap-2">
        <Icone nome="local" class="size-4 text-ambar-600" />
        Av. Farrapos, 1255 — esquina com a Rua Hoffmann, Floresta
      </p>
      <div class="flex items-center gap-7">
        <span class="flex items-center gap-2">
          <Icone nome="relogio" class="size-4 text-ambar-600" />
          Seg a sex 8h–18h · Sáb 9h–17h
        </span>
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2 font-semibold text-tinta-800 transition-colors hover:text-ambar-600"
        >
          <Icone nome="telefone" class="size-4 text-ambar-600" />
          {contato.telefoneFixo}
        </a>
      </div>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-7xl items-center gap-4 border-b border-tinta-950/10 px-4 py-3.5 sm:px-6"
  >
    <a href={url('/')} class="group flex shrink-0 items-center gap-3" aria-label={`${site.nome} — início`}>
      <Image
        src={logo}
        alt=""
        width={112}
        height={83}
        loading="eager"
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <span class="hidden sm:block">
        <span class="display block text-xl leading-none text-tinta-950">
          New Moto <span class="text-ambar-500 italic">Point</span>
        </span>
        <span class="rotulo mt-1.5 block text-[8.5px] text-tinta-400">
          Peças · Acessórios · Oficina
        </span>
      </span>
    </a>

    <nav class="mx-auto hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
      {
        navegacao.map((item) => {
          const ativo = ehAtivo(caminho, item.href);

          if (!item.sub) {
            return (
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'group relative px-3.5 py-2 text-[14px] transition-colors hover:text-tinta-950',
                  ativo ? 'font-semibold text-tinta-950' : 'font-medium text-tinta-600',
                ]}
              >
                {item.rotulo}
                <span
                  class:list={[
                    'absolute inset-x-3.5 -bottom-0.5 h-px origin-left bg-ambar-500 transition-transform duration-300 group-hover:scale-x-100',
                    ativo ? 'scale-x-100' : 'scale-x-0',
                  ]}
                />
              </a>
            );
          }

          // Submenu: abre no hover e também ao receber foco pelo teclado.
          // Enquanto fechado usa `invisible`, então os links de dentro ficam
          // fora da ordem de tabulação até o item de cima ser focado.
          return (
            <div class="group relative">
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-1.5 px-3.5 py-2 text-[14px] transition-colors hover:text-tinta-950',
                  ativo ? 'font-semibold text-tinta-950' : 'font-medium text-tinta-600',
                ]}
              >
                {item.rotulo}
                <Icone
                  nome="chevron"
                  class="size-3.5 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
                />
                <span
                  class:list={[
                    'absolute inset-x-3.5 -bottom-0.5 h-px origin-left bg-ambar-500 transition-transform duration-300 group-hover:scale-x-100',
                    ativo ? 'scale-x-100' : 'scale-x-0',
                  ]}
                />
              </a>

              <div class="invisible absolute top-full left-0 z-50 pt-3 opacity-0 transition-[opacity,transform] duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 max-lg:hidden lg:-translate-y-1">
                <ul
                  class="w-60 border border-tinta-950/12 bg-creme-50 py-2 shadow-2xl shadow-tinta-950/12"
                >
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        class="group/i flex items-center justify-between gap-3 px-5 py-2.5 text-sm text-tinta-600 transition-colors hover:bg-creme-100 hover:text-tinta-950"
                      >
                        {s.rotulo}
                        <Icone
                          nome="setaCurta"
                          class="size-3.5 text-ambar-500 opacity-0 transition-opacity group-hover/i:opacity-100"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>

    <a
      href={zap('Olá! Quero um orçamento na New Moto Point. Minha moto é uma ')}
      target="_blank"
      rel="noopener"
      class="ml-auto flex items-center gap-2 rounded-full border border-ambar-500 px-5 py-2.5 text-sm font-semibold text-tinta-950 transition-all hover:bg-ambar-400 lg:ml-0"
    >
      <Icone nome="whatsapp" class="size-4.5 text-ambar-600" />
      <span class="hidden sm:inline">Pedir orçamento</span>
      <span class="sm:hidden">Orçamento</span>
    </a>

    <button
      type="button"
      id="btn-menu"
      class="flex size-11 shrink-0 items-center justify-center rounded-full border border-tinta-950/15 text-tinta-800 transition-colors hover:border-ambar-500 hover:bg-ambar-400 lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path id="icone-abrir" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        <path id="icone-fechar" class="hidden" d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Menu mobile -->
  <div id="menu-mobile" hidden class="border-b border-tinta-950/10 bg-creme-100 lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6" aria-label="Navegação principal (mobile)">
      <ul class="divide-y divide-tinta-950/8">
        {
          navegacao.map((item) => (
            <li class="py-1.5">
              <a
                href={url(item.href)}
                data-fechar-menu
                aria-current={ehAtivo(caminho, item.href) ? 'page' : undefined}
                class:list={[
                  'display flex items-center justify-between py-2.5 text-2xl transition-colors hover:text-ambar-600',
                  ehAtivo(caminho, item.href) ? 'text-ambar-600' : 'text-tinta-950',
                ]}
              >
                {item.rotulo}
                <Icone nome="setaCurta" class="size-5 text-ambar-500" />
              </a>

              {item.sub && (
                <ul class="mb-2 flex flex-wrap gap-1.5">
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        data-fechar-menu
                        class="block rounded-full border border-tinta-950/15 px-3.5 py-1.5 text-[13px] text-tinta-600 transition-colors hover:border-ambar-500 hover:bg-ambar-400/20 hover:text-tinta-950"
                      >
                        {s.rotulo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-4 grid gap-2 text-sm">
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2.5 rounded-lg bg-creme-200 px-4 py-3 font-semibold text-tinta-950"
        >
          <Icone nome="telefone" class="size-4.5 text-ambar-600" />
          {contato.telefoneFixo}
        </a>
        <p class="flex items-center gap-2.5 px-4 text-tinta-500">
          <Icone nome="relogio" class="size-4.5 text-ambar-600" />
          Seg a sex 8h–18h (fecha 13h–14h) · Sáb 9h–17h
        </p>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-mobile');
  const iAbrir = document.getElementById('icone-abrir');
  const iFechar = document.getElementById('icone-fechar');

  function alternar(aberto: boolean) {
    if (!btn || !menu) return;
    menu.hidden = !aberto;
    btn.setAttribute('aria-expanded', String(aberto));
    btn.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    iAbrir?.classList.toggle('hidden', aberto);
    iFechar?.classList.toggle('hidden', !aberto);
  }

  btn?.addEventListener('click', () => alternar(menu?.hidden !== false));
  menu
    ?.querySelectorAll('[data-fechar-menu]')
    .forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.hidden === false) alternar(false);
  });
</script>
