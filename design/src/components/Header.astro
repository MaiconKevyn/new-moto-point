---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import logo from '../assets/img/brand/logo-new-moto.png';
import { site, contato, zap } from '../data/site';
import { navegacao, ehAtivo, url } from '../data/navegacao';

const caminho = Astro.url.pathname;
---

<header
  id="topo"
  class="sticky top-0 z-50 border-b border-white/8 bg-graphite-950/85 backdrop-blur-lg"
>
  <!-- Faixa de utilidades -->
  <div class="hidden border-b border-white/6 bg-graphite-950 lg:block">
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-2 text-[13px] text-white/60"
    >
      <p class="flex items-center gap-2">
        <Icone nome="local" class="size-4 text-moto-400" />
        Av. Farrapos, 1255 — Floresta, Porto Alegre/RS
      </p>
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2">
          <Icone nome="relogio" class="size-4 text-moto-400" />
          Seg a sex 8h–18h · Sáb 9h–17h
        </span>
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2 transition-colors hover:text-white"
        >
          <Icone nome="telefone" class="size-4 text-moto-400" />
          {contato.telefoneFixo}
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href={url('/')} class="group flex shrink-0 items-center gap-3" aria-label={`${site.nome} — início`}>
      <Image
        src={logo}
        alt=""
        width={112}
        height={83}
        loading="eager"
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <span class="hidden sm:block">
        <span class="display block text-xl leading-none tracking-wide text-white">
          New Moto <span class="text-moto-500">Point</span>
        </span>
        <span
          class="mt-0.5 block text-[10.5px] font-semibold tracking-[0.22em] text-white/45 uppercase"
        >
          Peças · Acessórios · Oficina
        </span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
      {
        navegacao.map((item) => {
          const ativo = ehAtivo(caminho, item.href);

          // Sem submenu: link simples.
          if (!item.sub) {
            return (
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'display rounded-md px-3.5 py-2 text-[17px] tracking-wide transition-colors hover:bg-white/6 hover:text-white',
                  ativo ? 'text-moto-400' : 'text-white/70',
                ]}
              >
                {item.rotulo}
              </a>
            );
          }

          // Com submenu: abre no passar do mouse e também ao receber foco pelo
          // teclado. Enquanto está escondido usa `invisible`, então os links de
          // dentro ficam fora da ordem de tabulação — quem chega pelo Tab abre
          // o painel ao focar o item de cima.
          return (
            <div class="group relative">
              <a
                href={url(item.href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'display flex items-center gap-1.5 rounded-md px-3.5 py-2 text-[17px] tracking-wide transition-colors hover:bg-white/6 hover:text-white',
                  ativo ? 'text-moto-400' : 'text-white/70',
                ]}
              >
                {item.rotulo}
                <Icone
                  nome="chevron"
                  class="size-4 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
                />
              </a>

              <div class="invisible absolute top-full left-0 z-50 pt-2 opacity-0 transition-[opacity,transform] duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 max-lg:hidden lg:-translate-y-1">
                <ul class="w-60 overflow-hidden rounded-xl border border-white/10 bg-graphite-900 py-2 shadow-2xl shadow-black/60">
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm font-semibold text-white/70 transition-colors hover:bg-moto-500/12 hover:text-white"
                      >
                        {s.rotulo}
                        <Icone nome="seta" class="size-4 text-moto-500 opacity-0 transition-opacity" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>

    <a
      href={zap()}
      target="_blank"
      rel="noopener"
      class="ml-auto flex items-center gap-2 rounded-lg bg-zap-500 px-4 py-2.5 text-sm font-bold text-graphite-950 shadow-lg shadow-zap-500/20 transition-all hover:bg-zap-400 hover:shadow-zap-500/30 lg:ml-4"
    >
      <Icone nome="whatsapp" class="size-5" />
      <span class="hidden sm:inline">Falar no WhatsApp</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>

    <button
      type="button"
      id="btn-menu"
      class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-white/12 text-white transition-colors hover:bg-white/8 lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path id="icone-abrir" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        <path id="icone-fechar" class="hidden" d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Menu mobile -->
  <div id="menu-mobile" hidden class="border-t border-white/8 bg-graphite-900 lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6" aria-label="Navegação principal (mobile)">
      <ul class="divide-y divide-white/6">
        {
          navegacao.map((item) => (
            <li class="py-1.5">
              <a
                href={url(item.href)}
                data-fechar-menu
                aria-current={ehAtivo(caminho, item.href) ? 'page' : undefined}
                class:list={[
                  'display flex items-center justify-between py-2.5 text-2xl transition-colors hover:text-moto-400',
                  ehAtivo(caminho, item.href) ? 'text-moto-400' : 'text-white/85',
                ]}
              >
                {item.rotulo}
                <Icone nome="seta" class="size-5 text-moto-500" />
              </a>

              {item.sub && (
                <ul class="mb-2 ml-1 flex flex-wrap gap-1.5">
                  {item.sub.map((s) => (
                    <li>
                      <a
                        href={url(s.href)}
                        data-fechar-menu
                        class="block rounded-lg border border-white/10 bg-white/4 px-3 py-1.5 text-[13px] font-semibold text-white/60 transition-colors hover:border-moto-500/50 hover:text-white"
                      >
                        {s.rotulo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-4 grid gap-2 text-sm">
        <a
          href={contato.telefoneFixoHref}
          class="flex items-center gap-2.5 rounded-lg bg-white/5 px-4 py-3 font-semibold text-white"
        >
          <Icone nome="telefone" class="size-4.5 text-moto-400" />
          {contato.telefoneFixo}
        </a>
        <p class="flex items-center gap-2.5 px-4 text-white/55">
          <Icone nome="relogio" class="size-4.5 text-moto-400" />
          Seg a sex 8h–18h (fecha 13h–14h) · Sáb 9h–17h
        </p>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-mobile');
  const iAbrir = document.getElementById('icone-abrir');
  const iFechar = document.getElementById('icone-fechar');

  function alternar(aberto: boolean) {
    if (!btn || !menu) return;
    menu.hidden = !aberto;
    btn.setAttribute('aria-expanded', String(aberto));
    btn.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    iAbrir?.classList.toggle('hidden', aberto);
    iFechar?.classList.toggle('hidden', !aberto);
  }

  btn?.addEventListener('click', () => alternar(menu?.hidden !== false));
  menu
    ?.querySelectorAll('[data-fechar-menu]')
    .forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.hidden === false) alternar(false);
  });
</script>
