---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { url } from '../data/navegacao';
import { fotos } from '../data/servicos';
import { site, contato, marcas, zap } from '../data/site';
---

<section class="relative isolate overflow-hidden bg-carbon-950 pb-14 lg:pb-24">
  <!-- Brilho vermelho atrás da foto -->
  <div
    class="absolute -top-24 right-[-18rem] -z-10 size-[46rem] rounded-full bg-rubi-600/25 blur-[150px]"
  >
  </div>
  <div class="textura-pontos absolute inset-0 -z-10 opacity-60"></div>

  <div
    class="mx-auto grid max-w-7xl items-center gap-10 px-4 pt-12 sm:px-6 lg:grid-cols-[1.02fr_1fr] lg:gap-8 lg:pt-16"
  >
    <!-- Texto -->
    <div>
      <p class="reveal flex flex-wrap items-center gap-x-3 gap-y-2">
        <span
          class="grad-rubi rotulo rounded-sm px-3 py-1.5 text-[10px] text-white shadow-lg shadow-rubi-900/40"
        >
          Desde {site.desde}
        </span>
        <span class="rotulo text-[10px] text-white/45">
          Av. Farrapos · Floresta · Porto Alegre
        </span>
      </p>

      <h1 class="reveal display mt-6 text-white" style="--reveal-delay:80ms">
        <span class="block text-[10.5vw] sm:text-5xl lg:text-6xl xl:text-7xl">Moto parada</span>
        <span class="block text-[10.5vw] sm:text-5xl lg:text-6xl xl:text-7xl">é dinheiro</span>
        <span class="block text-[10.5vw] text-rubi-500 sm:text-5xl lg:text-6xl xl:text-7xl">
          parado.
        </span>
      </h1>

      <p
        class="reveal mt-7 max-w-xl text-base leading-relaxed text-white/60 sm:text-lg"
        style="--reveal-delay:150ms"
      >
        Peça, acessório e oficina no mesmo balcão, com mão de obra certificada <strong
          class="font-semibold text-white">SENAC RS</strong
        >. Orçamento na hora pelo WhatsApp e <strong class="font-semibold text-white"
          >tele entrega</strong
        > na região — para você voltar a rodar no mesmo dia.
      </p>

      <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row" style="--reveal-delay:210ms">
        <a
          href={zap('Olá! Quero um orçamento na New Moto Point. Minha moto é uma ')}
          target="_blank"
          rel="noopener"
          class="group flex items-center justify-center gap-2.5 rounded-sm bg-zap-500 px-7 py-4 font-extrabold tracking-wide text-carbon-950 uppercase shadow-xl shadow-zap-500/20 transition-all hover:bg-zap-400"
        >
          <Icone nome="whatsapp" class="size-5.5" />
          Pedir orçamento
          <Icone
            nome="seta"
            class="size-5 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
        <a
          href={url('/oficina/#servicos')}
          class="flex items-center justify-center gap-2.5 rounded-sm border border-white/20 px-7 py-4 font-extrabold tracking-wide text-white uppercase transition-all hover:border-rubi-500 hover:bg-rubi-500"
        >
          <Icone nome="ferramentas" class="size-5" />
          Ver a oficina
        </a>
      </div>

      <p class="reveal mt-6 text-sm text-white/45" style="--reveal-delay:260ms">
        Ou ligue para <a
          href={contato.telefoneFixoHref}
          class="font-semibold text-white underline decoration-rubi-500 decoration-2 underline-offset-4 transition-colors hover:text-rubi-400"
          >{contato.telefoneFixo}</a
        > — atendemos de segunda a sábado.
      </p>
    </div>

    <!-- Foto da oficina, cortada na diagonal -->
    <div class="reveal relative" style="--reveal-delay:120ms">
      <div
        class="relative aspect-4/3 overflow-hidden lg:aspect-5/6"
        style="clip-path:polygon(0 0,100% 0,100% 88%,86% 100%,0 100%)"
      >
        <Image
          src={fotos.manutencao}
          alt="Mecânico da New Moto Point fazendo manutenção em uma moto na oficina da Av. Farrapos"
          widths={[500, 800, 1200]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
        <div
          class="absolute inset-0 bg-linear-to-tr from-carbon-950 via-carbon-950/25 to-rubi-600/25"
        >
        </div>
      </div>

      <!-- Selo de anos, sobreposto -->
      <div
        class="grad-rubi absolute -bottom-5 left-4 flex items-center gap-4 px-6 py-4 shadow-2xl shadow-black/60 sm:left-8"
      >
        <span class="display text-5xl leading-none text-white">
          {new Date().getFullYear() - site.desde}
        </span>
        <span class="rotulo text-[10px] leading-relaxed text-white/85">
          anos na<br />Av. Farrapos
        </span>
      </div>
    </div>
  </div>

  <!-- Marcas atendidas -->
  <div class="reveal mx-auto mt-16 max-w-7xl px-4 sm:px-6" style="--reveal-delay:300ms">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-white/10 pt-8">
      <p class="rotulo text-[10px] text-white/35">Trabalhamos com</p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
        {
          marcas.map((m) => (
            <span class="display text-xl text-white/45 transition-colors hover:text-white/80 sm:text-2xl">
              {m}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
