---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { vitrines, linhasDePecas } from '../data/catalogo';
import { marcas, zap } from '../data/site';

const oleos = vitrines.find((v) => v.id === 'oleos')!;
---

<section id="pecas" class="relative overflow-hidden bg-tinta-950 py-20 lg:py-28">
  <div class="absolute -top-32 -right-32 size-[34rem] rounded-full bg-ambar-600/10 blur-[150px]"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSecao
      escuro
      sobretitulo="Peças de reposição"
      titulo="Peça original ou de reposição,"
      destaque="para as cinco marcas."
      texto="Se a peça não estiver no estoque, a gente procura e avisa o prazo. Sem fazer você rodar a cidade atrás de fornecedor."
    />

    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <!-- Linhas atendidas, em fio de régua -->
      <div>
        <h3 class="reveal display text-2xl text-white sm:text-3xl">O que temos em estoque</h3>

        <ul class="reveal mt-7 grid gap-x-10 sm:grid-cols-2">
          {
            linhasDePecas.map((l) => (
              <li class="flex items-center gap-3 border-b border-white/12 py-3 text-sm text-white/70">
                <Icone nome="check" class="size-4 shrink-0 text-ambar-400" />
                {l}
              </li>
            ))
          }
        </ul>

        <div class="reveal mt-9">
          <p class="rotulo text-[10px] text-white/40">Atendemos</p>
          <div class="mt-4 flex flex-wrap gap-x-7 gap-y-3">
            {marcas.map((m) => <span class="display text-2xl text-white/70">{m}</span>)}
          </div>
        </div>

        <a
          href={zap('Olá! Estou procurando uma peça. Modelo da moto: ___ / Peça: ___. Vocês têm?')}
          target="_blank"
          rel="noopener"
          class="reveal group mt-9 inline-flex items-center gap-2.5 rounded-full bg-ambar-400 px-7 py-3.5 font-semibold text-tinta-950 transition-all hover:bg-ambar-300"
        >
          <Icone nome="whatsapp" class="size-5" />
          Consultar uma peça
          <Icone
            nome="seta"
            class="size-4.5 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>

      <!-- Óleos -->
      <div id="oleos" class="scroll-mt-28">
        <div class="reveal flex items-end justify-between gap-4">
          <div>
            <h3 class="display text-2xl text-white sm:text-3xl">{oleos.titulo}</h3>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-white/55">{oleos.descricao}</p>
          </div>
          <span
            class="hidden shrink-0 rounded-full border border-ambar-400/50 px-3.5 py-1.5 text-[11px] font-semibold text-ambar-300 sm:block"
          >
            Troca na hora
          </span>
        </div>

        <div class="mt-7 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3">
          {oleos.itens.map((p, i) => <CardProduto produto={p} tema="escuro" atraso={i * 70} />)}
        </div>
      </div>
    </div>

    <!-- Tele entrega -->
    <div
      class="reveal mt-14 flex flex-col items-start gap-6 border-t border-white/12 pt-10 sm:flex-row sm:items-center"
    >
      <Icone nome="entrega" class="size-9 shrink-0 text-ambar-400" />
      <div class="flex-1">
        <h3 class="display text-2xl text-white">Tele entrega e busca da moto</h3>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/55">
          Levamos a peça até você ou buscamos sua moto na região. Combine a taxa no atendimento.
        </p>
      </div>
      <a
        href={zap('Olá! Quero saber sobre tele entrega / busca da moto na região.')}
        target="_blank"
        rel="noopener"
        class="flex shrink-0 items-center gap-2.5 rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white transition-all hover:border-ambar-400 hover:bg-ambar-400 hover:text-tinta-950"
      >
        <Icone nome="whatsapp" class="size-4.5" />
        Combinar entrega
      </a>
    </div>
  </div>
</section>
