---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import { ofertas, vitrines } from '../data/catalogo';
import { servicos, especialidades } from '../data/servicos';
import { endereco } from '../data/site';
import { url } from '../data/navegacao';

// Números tirados do próprio catálogo — não há contagem escrita à mão que
// possa ficar desatualizada quando um produto entrar ou sair.
const totalProdutos =
  ofertas.length + vitrines.reduce((soma, v) => soma + v.itens.length, 0);

const areas = [
  {
    href: '/loja/',
    icone: 'loja',
    titulo: 'A loja',
    texto: `${totalProdutos} itens no catálogo: luva e roupa térmica em oferta, capa de chuva, baú, grelha, viseira original, óleo e peça de reposição.`,
    marcador: `${totalProdutos} itens`,
    acao: 'Ver o catálogo',
  },
  {
    href: '/oficina/',
    icone: 'ferramentas',
    titulo: 'A oficina',
    texto: `${servicos.length} serviços na bancada e mão de obra certificada SENAC RS para ${especialidades.map((e) => e.nome.toLowerCase()).join(', ')}.`,
    marcador: `${servicos.length} serviços`,
    acao: 'Ver os serviços',
  },
  {
    href: '/contato/',
    icone: 'local',
    titulo: 'Onde estamos',
    texto: `${endereco.rua}, ${endereco.complemento}. Bairro ${endereco.bairro}, com mapa, horários e todos os canais de atendimento.`,
    marcador: 'Seg a sáb',
    acao: 'Como chegar',
  },
];
---

<section class="relative overflow-hidden bg-carbon-950 py-20 lg:py-24">
  <div class="textura-pontos absolute inset-0 opacity-50"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSecao
      centro
      sobretitulo="O que você procura"
      titulo="Três caminhos,"
      destaque="um endereço só."
      texto="A loja, a oficina e o atendimento agora têm cada um a sua página — vá direto ao que você precisa."
    />

    <div class="mt-14 grid gap-px overflow-hidden border border-white/8 bg-white/8 lg:grid-cols-3">
      {
        areas.map((a, i) => (
          <a
            href={url(a.href)}
            class="reveal group flex flex-col bg-carbon-950 p-7 transition-colors duration-300 hover:bg-carbon-850 lg:p-8"
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="flex items-center justify-between gap-4">
              <span class="flex size-12 rotate-45 items-center justify-center rounded-sm border border-rubi-500/45 bg-rubi-500/10 text-rubi-500 transition-all duration-300 group-hover:border-rubi-500 group-hover:bg-rubi-500 group-hover:text-white">
                <Icone nome={a.icone} class="size-5.5 -rotate-45" />
              </span>
              <span class="rotulo text-[9.5px] text-white/40">{a.marcador}</span>
            </div>

            <h3 class="display mt-7 text-2xl text-white">{a.titulo}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-white/55">{a.texto}</p>

            <span class="mt-6 inline-flex items-center gap-2 text-[12.5px] font-extrabold tracking-wider text-rubi-400 uppercase transition-colors group-hover:text-white">
              {a.acao}
              <Icone
                nome="seta"
                class="size-4 transition-transform duration-300 group-hover:translate-x-1"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
