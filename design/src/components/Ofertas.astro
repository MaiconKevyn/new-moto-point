---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { ofertas, desconto } from '../data/catalogo';
import { zap } from '../data/site';

interface Props {
  /** Quantas ofertas mostrar. Sem limite, mostra todas (página da loja). */
  limite?: number;
}

const { limite } = Astro.props;

const lista = limite ? ofertas.slice(0, limite) : ofertas;
const resumido = Boolean(limite) && ofertas.length > lista.length;

// O desconto anunciado é sempre o maior do catálogo, mesmo na home resumida:
// senão a chamada muda de número conforme a vitrine é cortada.
const maiorOff = Math.max(...ofertas.map((o) => desconto(o) ?? 0));
---

<section id="ofertas" class="relative overflow-hidden bg-graphite-900 py-20 lg:py-28">
  <div
    class="absolute top-0 left-1/2 h-px w-full max-w-4xl -translate-x-1/2 bg-linear-to-r from-transparent via-moto-500/50 to-transparent"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <TituloSecao
        sobretitulo="Ofertas da loja"
        titulo="Luvas e roupas térmicas com até"
        destaque={`${maiorOff}% off`}
        texto="Estoque limitado, tamanhos e modelos conforme disponibilidade. Confirme no WhatsApp e retire na loja ou peça tele entrega."
      />

      <a
        href={resumido ? '/loja/#ofertas' : zap('Olá! Quero saber quais ofertas ainda estão disponíveis na New Moto Point.')}
        target={resumido ? undefined : '_blank'}
        rel={resumido ? undefined : 'noopener'}
        class="reveal group inline-flex shrink-0 items-center gap-2.5 self-start rounded-xl border border-white/15 px-6 py-3.5 font-bold text-white transition-all hover:border-zap-500 hover:bg-zap-500 hover:text-graphite-950 lg:self-auto"
      >
        {resumido ? `Ver as ${ofertas.length} ofertas` : 'Ver disponibilidade'}
        <Icone
          nome="seta"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
      {lista.map((p, i) => <CardProduto produto={p} atraso={(i % 4) * 60} />)}
    </div>

    <p
      class="reveal mt-8 flex items-start gap-2.5 text-xs leading-relaxed text-white/40 sm:items-center"
    >
      <Icone nome="check" class="mt-0.5 size-4 shrink-0 text-moto-500 sm:mt-0" />
      Preços à vista. Trabalhamos com pagamento facilitado — pergunte as condições no atendimento.
    </p>
  </div>
</section>
