---
import Icone from './Icone.astro';
import { contato, endereco, horarios, redes, zap } from '../data/site';

/** `numero: true` usa a serifa de display; texto longo fica no corpo normal
 *  para não estourar a largura da linha. */
const canais = [
  {
    icone: 'whatsapp',
    rotulo: 'WhatsApp',
    valor: contato.celular,
    href: zap(),
    nota: 'Resposta mais rápida — orçamento e fotos',
    numero: true,
  },
  {
    icone: 'telefone',
    rotulo: 'Telefone da loja',
    valor: contato.telefoneFixo,
    href: contato.telefoneFixoHref,
    nota: 'Durante o horário de atendimento',
    numero: true,
  },
  {
    icone: 'email',
    rotulo: 'E-mail',
    valor: contato.email,
    href: `mailto:${contato.email}`,
    nota: 'Para orçamentos de empresa e frota',
    numero: false,
  },
  {
    icone: 'instagram',
    rotulo: 'Instagram',
    valor: redes.instagramHandle,
    href: redes.instagram,
    nota: 'Novidades e chegadas de estoque',
    numero: false,
  },
];
---

<section id="contato" class="bg-creme-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <!-- Canais + horários -->
      <div>
        <ul class="reveal border-t border-tinta-950/14">
          {
            canais.map((c) => (
              <li class="fio group">
                <a
                  href={c.href}
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener' : undefined}
                  class="flex items-center gap-5 py-5"
                >
                  <Icone
                    nome={c.icone}
                    class="size-5.5 shrink-0 text-ambar-500 transition-colors group-hover:text-ambar-600"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="rotulo block text-[9px] text-tinta-400">{c.rotulo}</span>
                    <span
                      class:list={[
                        'mt-1 block text-tinta-950 transition-colors group-hover:text-ambar-600',
                        c.numero ? 'display text-2xl' : 'text-[15px] font-semibold [overflow-wrap:anywhere]',
                      ]}
                    >
                      {c.valor}
                    </span>
                    <span class="mt-1 block text-xs text-tinta-500">{c.nota}</span>
                  </span>
                  <span
                    class="flex size-10 shrink-0 items-center justify-center rounded-full border border-tinta-950/20 text-tinta-600 transition-all duration-300 group-hover:border-ambar-400 group-hover:bg-ambar-400 group-hover:text-tinta-950"
                    aria-hidden="true"
                  >
                    <Icone nome="setaCurta" class="size-4" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Horários -->
        <div class="reveal mt-10 border border-tinta-950/14 p-7">
          <div class="flex items-center gap-3">
            <Icone nome="relogio" class="size-5 text-ambar-500" />
            <h3 class="display text-2xl text-tinta-950">Horário de atendimento</h3>
          </div>
          <dl class="mt-5 divide-y divide-tinta-950/10">
            {
              horarios.map((h) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-sm text-tinta-500">{h.dia}</dt>
                  <dd class="text-right">
                    <span
                      class:list={[
                        'display text-xl',
                        h.hora === 'Fechado' ? 'text-tinta-400' : 'text-tinta-950',
                      ]}
                    >
                      {h.hora}
                    </span>
                    {h.obs && <span class="block text-[11px] text-tinta-400">{h.obs}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <!-- Endereço + mapa -->
      <div class="reveal flex flex-col">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <address class="text-sm leading-relaxed text-tinta-500 not-italic">
            <strong class="display block text-3xl text-tinta-950 sm:text-4xl">
              {endereco.rua}
            </strong>
            <span class="mt-3 block">
              {endereco.complemento}<br />
              Bairro {endereco.bairro} · {endereco.cidade}/{endereco.estado}<br />
              CEP {endereco.cep}
            </span>
          </address>
          <a
            href={endereco.mapsDirecoes}
            target="_blank"
            rel="noopener"
            class="group inline-flex shrink-0 items-center gap-2.5 rounded-full bg-tinta-950 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-ambar-400 hover:text-tinta-950"
          >
            Traçar rota
            <Icone
              nome="setaCurta"
              class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>

        <!-- Enquanto o mapa carrega (ou se for bloqueado), aparece o aviso abaixo -->
        <div
          class="relative mt-7 flex min-h-96 flex-1 items-center justify-center border border-tinta-950/14 bg-creme-200"
        >
          <p class="absolute px-6 text-center text-sm text-tinta-500">
            Carregando o mapa… se não aparecer, use o botão <strong class="font-semibold"
              >Traçar rota</strong
            >.
          </p>
          <iframe
            src={endereco.mapsEmbed}
            title="Mapa com a localização da New Moto Point na Av. Farrapos, 1255, Porto Alegre"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 size-full border-0 grayscale-[0.5] transition-[filter] duration-500 hover:grayscale-0"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
