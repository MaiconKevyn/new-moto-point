---
import Icone from './Icone.astro';
import { contato, endereco, horarios, redes, zap } from '../data/site';

/** `numero: true` usa a tipografia de display; texto longo fica no corpo
 *  normal para não estourar a largura da linha. */
const canais = [
  {
    icone: 'whatsapp',
    rotulo: 'WhatsApp',
    valor: contato.celular,
    href: zap(),
    nota: 'Resposta mais rápida — orçamento e fotos',
    numero: true,
    destaque: true,
  },
  {
    icone: 'telefone',
    rotulo: 'Telefone da loja',
    valor: contato.telefoneFixo,
    href: contato.telefoneFixoHref,
    nota: 'Durante o horário de atendimento',
    numero: true,
  },
  {
    icone: 'email',
    rotulo: 'E-mail',
    valor: contato.email,
    href: `mailto:${contato.email}`,
    nota: 'Para orçamentos de empresa e frota',
    numero: false,
  },
  {
    icone: 'instagram',
    rotulo: 'Instagram',
    valor: redes.instagramHandle,
    href: redes.instagram,
    nota: 'Novidades e chegadas de estoque',
    numero: false,
  },
];
---

<section id="contato" class="bg-carbon-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.15fr]">
      <!-- Canais + horários -->
      <div class="space-y-6">
        <ul class="reveal divide-y divide-carbon-950/10 border border-carbon-950/12 bg-white">
          {
            canais.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener' : undefined}
                  class:list={[
                    'group flex items-center gap-4 p-5 transition-colors',
                    c.destaque ? 'bg-zap-500/10 hover:bg-zap-500/18' : 'hover:bg-carbon-50',
                  ]}
                >
                  <span
                    class:list={[
                      'flex size-11 shrink-0 items-center justify-center rounded-sm transition-colors',
                      c.destaque
                        ? 'bg-zap-500 text-carbon-950'
                        : 'bg-carbon-950 text-white group-hover:bg-rubi-500',
                    ]}
                  >
                    <Icone nome={c.icone} class="size-5.5" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="rotulo block text-[9.5px] text-carbon-500">{c.rotulo}</span>
                    <span
                      class:list={[
                        'mt-1 block text-carbon-950',
                        c.numero ? 'display text-xl' : 'text-[15px] font-semibold [overflow-wrap:anywhere]',
                      ]}
                    >
                      {c.valor}
                    </span>
                    <span class="mt-0.5 block text-xs text-carbon-500">{c.nota}</span>
                  </span>
                  <Icone
                    nome="seta"
                    class="size-5 shrink-0 text-carbon-500 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-rubi-500"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Horários -->
        <div class="reveal bg-carbon-950 p-7">
          <div class="flex items-center gap-3">
            <Icone nome="relogio" class="size-5 text-rubi-500" />
            <h3 class="display text-xl text-white">Horário de atendimento</h3>
          </div>
          <dl class="mt-5 divide-y divide-white/10">
            {
              horarios.map((h) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-sm text-white/60">{h.dia}</dt>
                  <dd class="text-right">
                    <span
                      class:list={[
                        'display text-lg',
                        h.hora === 'Fechado' ? 'text-white/35' : 'text-white',
                      ]}
                    >
                      {h.hora}
                    </span>
                    {h.obs && <span class="block text-[11px] text-white/40">{h.obs}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <!-- Endereço + mapa -->
      <div class="reveal flex flex-col border border-carbon-950/12 bg-white">
        <div class="flex flex-wrap items-start justify-between gap-4 p-6">
          <div class="flex gap-4">
            <span class="grad-rubi flex size-11 shrink-0 items-center justify-center rounded-sm text-white">
              <Icone nome="local" class="size-5.5" />
            </span>
            <address class="text-sm leading-relaxed text-carbon-700 not-italic">
              <strong class="display block text-xl text-carbon-950">{endereco.rua}</strong>
              {endereco.complemento}<br />
              Bairro {endereco.bairro} · {endereco.cidade}/{endereco.estado}<br />
              CEP {endereco.cep}
            </address>
          </div>
          <a
            href={endereco.mapsDirecoes}
            target="_blank"
            rel="noopener"
            class="group inline-flex shrink-0 items-center gap-2 rounded-sm bg-carbon-950 px-5 py-3 text-[12.5px] font-extrabold tracking-wider text-white uppercase transition-colors hover:bg-rubi-500"
          >
            Traçar rota
            <Icone
              nome="setaCurta"
              class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>

        <!-- Enquanto o mapa carrega (ou se for bloqueado), aparece o aviso abaixo -->
        <div class="relative flex min-h-80 flex-1 items-center justify-center bg-carbon-100">
          <p class="absolute px-6 text-center text-sm text-carbon-500">
            Carregando o mapa… se não aparecer, use o botão <strong class="font-semibold"
              >Traçar rota</strong
            >.
          </p>
          <iframe
            src={endereco.mapsEmbed}
            title="Mapa com a localização da New Moto Point na Av. Farrapos, 1255, Porto Alegre"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 size-full border-0 grayscale-[0.4] transition-[filter] duration-500 hover:grayscale-0"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
