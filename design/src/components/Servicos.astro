---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { servicos, especialidades, fotos } from '../data/servicos';
import { zap, zapServico } from '../data/site';
---

<section id="oficina" class="relative overflow-hidden bg-carbon-950 pt-20 pb-20 lg:pt-28 lg:pb-28">
  <div class="textura-pontos absolute inset-0 opacity-50"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Grade de serviços: losango vermelho + texto -->
    <div
      id="servicos"
      class="grid scroll-mt-28 gap-px overflow-hidden border border-white/8 bg-white/8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        servicos.map((s, i) => (
          <article
            class="reveal group flex flex-col bg-carbon-950 p-7 transition-colors duration-300 hover:bg-carbon-850 lg:p-8"
            style={`--reveal-delay:${(i % 3) * 80}ms`}
          >
            <span class="flex size-12 rotate-45 items-center justify-center rounded-sm border border-rubi-500/45 bg-rubi-500/10 text-rubi-500 transition-all duration-300 group-hover:border-rubi-500 group-hover:bg-rubi-500 group-hover:text-white">
              <Icone nome={s.icone} class="size-5.5 -rotate-45" />
            </span>

            <h3 class="display mt-7 text-2xl text-white">{s.nome}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-white/55">{s.resumo}</p>

            <a
              href={zapServico(s.nome)}
              target="_blank"
              rel="noopener"
              class="mt-6 inline-flex items-center gap-2 text-[12.5px] font-extrabold tracking-wider text-rubi-400 uppercase transition-colors hover:text-white"
            >
              Quero agendar
              <Icone
                nome="seta"
                class="size-4 transition-transform duration-300 group-hover:translate-x-1"
              />
            </a>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Faixa de especialidades sobre foto da própria oficina -->
  <div id="especialidades" class="relative mt-20 scroll-mt-28 lg:mt-28">
    <div class="absolute inset-0">
      <Image
        src={fotos.oficina}
        alt=""
        widths={[800, 1400, 1920]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="size-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-carbon-950/88"></div>
      <div class="absolute inset-0 bg-linear-to-r from-carbon-950 via-carbon-950/60 to-rubi-900/45"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <div class="reveal max-w-2xl">
        <p class="rotulo flex items-center gap-3 text-[11px] text-rubi-400">
          <span class="hachura block h-2.5 w-8 bg-rubi-500"></span>
          Mão de obra certificada
        </p>
        <h3 class="display mt-5 text-3xl text-white sm:text-4xl lg:text-5xl">
          Também resolvemos o que a maioria <span class="text-rubi-500">manda para fora</span>
        </h3>
        <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-white/60">
          Motor, embreagem, parte elétrica, suspensão e injeção eletrônica. Se sua moto precisa de
          diagnóstico, traga na Farrapos que a gente abre e mostra o problema.
        </p>
      </div>

      <ul class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay:100ms">
        {
          especialidades.map((e) => (
            <li class="flex items-center gap-2.5 rounded-sm border border-white/15 bg-carbon-950/70 px-4 py-2.5 backdrop-blur-sm transition-colors hover:border-rubi-500 hover:bg-rubi-500/15">
              <Icone nome={e.icone} class="size-5 text-rubi-400" />
              <span class="text-sm font-bold tracking-wide text-white uppercase">{e.nome}</span>
            </li>
          ))
        }
      </ul>

      <a
        href={zap('Olá! Preciso de um diagnóstico na oficina da New Moto Point. Minha moto é uma ')}
        target="_blank"
        rel="noopener"
        class="reveal group mt-10 inline-flex items-center gap-2.5 rounded-sm bg-white px-7 py-4 font-extrabold tracking-wide text-carbon-950 uppercase transition-all hover:bg-rubi-500 hover:text-white"
        style="--reveal-delay:160ms"
      >
        <Icone nome="whatsapp" class="size-5" />
        Descrever o problema
        <Icone
          nome="seta"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
