---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { servicos, especialidades, fotos } from '../data/servicos';
import { zap, zapServico } from '../data/site';
---

<section id="oficina" class="relative overflow-hidden bg-graphite-950 py-20 lg:py-28">
  <div class="grid-texture absolute inset-0 opacity-50"></div>
  <div
    class="absolute -bottom-40 -left-32 size-[34rem] rounded-full bg-moto-700/14 blur-[140px]"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Serviços em destaque, com foto -->
    <div id="servicos" class="grid scroll-mt-28 gap-5 lg:grid-cols-3">
      {
        servicos
          .filter((s) => s.destaque)
          .map((s, i) => (
            <article
              class="reveal group relative flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-2xl border border-white/8 bg-graphite-850"
              style={`--reveal-delay:${i * 90}ms`}
            >
              {s.img && (
                <Image
                  src={s.img}
                  alt={`Serviço de ${s.nome} na oficina da New Moto Point`}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 420px, 92vw"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out-quint group-hover:scale-108"
                />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-graphite-950 via-graphite-950/80 to-graphite-950/15" />

              <div class="relative p-6">
                <span class="flex size-12 items-center justify-center rounded-xl bg-moto-500 text-white shadow-lg shadow-moto-700/40">
                  <Icone nome={s.icone} class="size-6" />
                </span>
                <h3 class="display mt-5 text-3xl tracking-wide text-white">{s.nome}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-white/60">{s.resumo}</p>
                <a
                  href={zapServico(s.nome)}
                  target="_blank"
                  rel="noopener"
                  class="mt-5 inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2.5 text-sm font-bold text-white backdrop-blur-sm transition-colors hover:bg-zap-500 hover:text-graphite-950"
                >
                  <Icone nome="whatsapp" class="size-4.5" />
                  Quero agendar
                </a>
              </div>
            </article>
          ))
      }
    </div>

    <!-- Demais serviços -->
    <div class="mt-5 grid gap-5 sm:grid-cols-3">
      {
        servicos
          .filter((s) => !s.destaque)
          .map((s, i) => (
            <article
              class="reveal group flex flex-col rounded-2xl border border-white/8 bg-graphite-900 p-6 transition-colors hover:border-moto-500/40 hover:bg-graphite-850"
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span class="flex size-11 items-center justify-center rounded-xl bg-moto-500/12 text-moto-500 transition-colors group-hover:bg-moto-500 group-hover:text-white">
                <Icone nome={s.icone} class="size-5.5" />
              </span>
              <h3 class="display mt-4 text-2xl tracking-wide text-white">{s.nome}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-white/55">{s.resumo}</p>
              <a
                href={zapServico(s.nome)}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-moto-400 transition-colors hover:text-moto-300"
              >
                Quero agendar
                <Icone nome="seta" class="size-4" />
              </a>
            </article>
          ))
      }
    </div>

    <!-- Especialidades de mão de obra -->
    <div
      id="especialidades"
      class="reveal mt-14 scroll-mt-28 overflow-hidden rounded-2xl border border-white/8 bg-linear-to-br from-graphite-850 to-graphite-900"
    >
      <div class="grid lg:grid-cols-[1.15fr_1fr]">
        <div class="p-7 lg:p-10">
          <p class="text-xs font-bold tracking-[0.24em] text-moto-500 uppercase">
            Mão de obra certificada
          </p>
          <h3 class="display mt-4 text-3xl text-white sm:text-4xl">
            Também resolvemos o que a maioria manda para fora
          </h3>
          <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-white/55">
            Motor, embreagem, parte elétrica, suspensão e injeção eletrônica. Se sua moto precisa
            de diagnóstico, traga na Farrapos que a gente abre e mostra o problema.
          </p>

          <ul class="mt-7 flex flex-wrap gap-2.5">
            {
              especialidades.map((e) => (
                <li class="flex items-center gap-2 rounded-lg border border-white/12 bg-white/4 px-3.5 py-2">
                  <Icone nome={e.icone} class="size-4.5 text-moto-400" />
                  <span class="display text-lg tracking-wide text-white/85">{e.nome}</span>
                </li>
              ))
            }
          </ul>

          <a
            href={zap(
              'Olá! Preciso de um diagnóstico na oficina da New Moto Point. Minha moto é uma ',
            )}
            target="_blank"
            rel="noopener"
            class="group mt-8 inline-flex items-center gap-2.5 rounded-xl bg-moto-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-moto-700/30 transition-all hover:bg-moto-600"
          >
            <Icone nome="whatsapp" class="size-5" />
            Descrever o problema
            <Icone
              nome="seta"
              class="size-5 transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>

        <div class="relative min-h-64 lg:min-h-full">
          <Image
            src={fotos.manutencao}
            alt="Mecânico da New Moto Point fazendo manutenção em uma moto na oficina"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-graphite-950/70 via-transparent to-transparent lg:bg-linear-to-r lg:from-graphite-850 lg:via-graphite-850/25 lg:to-transparent"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
